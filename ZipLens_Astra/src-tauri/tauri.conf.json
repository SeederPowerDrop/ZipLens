{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZipLens 2.0",
  "version": "2.0.0",
  "identifier": "com.ziplens.astra",
  "build": {
    "beforeDevCommand": "python3 scripts/prepare-distribution.py && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "python3 scripts/prepare-distribution.py && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZipLens 2.0",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/7zz",
      "binaries/ziplens-legacy"
    ],
    "fileAssociations": [
      {
        "name": "Archive",
        "ext": [
          "zip",
          "zipx",
          "7z",
          "rar",
          "alz",
          "egg",
          "tar",
          "gz",
          "gzip",
          "tgz",
          "bz2",
          "bzip2",
          "tbz",
          "tbz2",
          "xz",
          "txz",
          "zst",
          "zstd",
          "tzst",
          "lzma",
          "z",
          "cab",
          "lzh",
          "lha",
          "arj",
          "cpio",
          "ar",
          "xar",
          "wim",
          "cbz",
          "cbr",
          "cb7",
          "cbt",
          "iso",
          "dmg",
          "001"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "resources": {
      "../legal/": "legal/"
    }
  }
}
