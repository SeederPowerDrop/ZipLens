{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZipLens",
  "version": "2.1.2",
  "identifier": "com.ziplens.astra",
  "build": {
    "beforeDevCommand": "python3 scripts/prepare-distribution.py && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "python3 scripts/prepare-distribution.py && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZipLens",
        "width": 800,
        "height": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/7zz",
      "binaries/ziplens-legacy"
    ],
    "fileAssociations": [
      {
        "name": "ZIP Archive",
        "ext": [
          "zip",
          "zipx",
          "cbz"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "7-Zip Archive",
        "ext": [
          "7z",
          "cb7"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "RAR Archive",
        "ext": [
          "rar",
          "cbr"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "TAR Archive",
        "ext": [
          "tar",
          "cbt"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Gzip Archive",
        "ext": [
          "gz",
          "gzip",
          "tgz",
          "z"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Bzip2 Archive",
        "ext": [
          "bz2",
          "bzip2",
          "tbz",
          "tbz2"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "XZ Archive",
        "ext": [
          "xz",
          "txz",
          "lzma"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Zstandard Archive",
        "ext": [
          "zst",
          "zstd",
          "tzst"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Legacy Archive",
        "ext": [
          "alz",
          "egg",
          "cab",
          "lzh",
          "lha",
          "arj",
          "cpio",
          "ar",
          "xar",
          "wim"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Archive Container",
        "ext": [
          "iso",
          "dmg",
          "001"
        ],
        "description": "Compressed Archive File",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "resources": {
      "../legal/": "legal/",
      "icons/archive-zip.icns": "archive-zip-v2.icns",
      "icons/archive-7z.icns": "archive-7z-v2.icns",
      "icons/archive-rar.icns": "archive-rar-v2.icns",
      "icons/archive-tar.icns": "archive-tar-v2.icns",
      "icons/archive-gzip.icns": "archive-gzip-v2.icns",
      "icons/archive-bzip2.icns": "archive-bzip2-v2.icns",
      "icons/archive-xz.icns": "archive-xz-v2.icns",
      "icons/archive-zstd.icns": "archive-zstd-v2.icns",
      "icons/archive-legacy.icns": "archive-legacy-v2.icns",
      "icons/archive-generic.icns": "archive-generic-v2.icns"
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "bundleVersion": "2.1.3"
    }
  }
}
